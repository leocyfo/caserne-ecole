rules_version = '2';
// PompierNote : qui peut lire et modifier quoi.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/proprietaire; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function acctDoc() { return /databases/$(database)/documents/comptes/$(request.auth.uid); }
    function hasAcct() { return signedIn() && exists(acctDoc()); }
    function role() { return hasAcct() ? get(acctDoc()).data.role : ''; }
    function isAdmin() { return isOwner() || role() == 'admin'; }
    function isStaff() { return isAdmin() || role() == 'teacher'; }
    function member() { return isOwner() || hasAcct(); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function myRef() { return hasAcct() ? get(acctDoc()).data.ref : ''; }
    function isTeacher() { return role() == 'teacher'; }

    // Le premier compte créé devient le propriétaire (administrateur) ; ensuite, plus personne.
    match /config/proprietaire {
      allow read: if true;
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /config/ecole { allow read: if member(); allow write: if isAdmin(); }

    match /groupes/{id} { allow read: if member(); allow write: if isAdmin(); }
    match /cours/{id} { allow read: if member(); allow write: if isAdmin(); }
    match /enseignants/{id} { allow read: if member(); allow write: if isAdmin(); }
    match /profs-absents/{id} { allow read: if member(); allow write: if isAdmin(); }
    match /examens/{id} { allow read: if member(); allow write: if isStaff(); }

    // Listes d’élèves et présences : enseignants et administration seulement
    match /eleves/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /presences/{id} { allow read, write: if isStaff(); }

    // Dossiers et présences du personnel : administration seulement
    match /dossiers-personnel/{id} { allow read, write: if isAdmin(); }
    match /presences-personnel/{id} { allow read, write: if isAdmin(); }

    // Affectation des enseignants : chaque enseignant postule (statut « attente ») et retire sa propre candidature ;
    // l’administration approuve, refuse ou retire.
    // Stock : le personnel lit et inscrit les mouvements ; l’administration gère le reste
    match /stock/{id} {
      allow read: if isStaff() || (hasAcct() && resource.data.aId == myRef());
      allow write: if isStaff();
    }
    match /stock-mvt/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }
    // Catalogue du stock : le personnel lit ; fournisseurs, commandes, réparations et comptages : l’administration
    match /stock-modeles/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /stock-fourn/{id} { allow read, write: if isAdmin(); }
    match /stock-cmd/{id} { allow read, write: if isAdmin(); }
    match /stock-rep/{id} { allow read, write: if isAdmin(); }
    match /stock-cpt/{id} { allow read, write: if isAdmin(); }
    // Compta : l’administration seulement
    match /compta/{id} {
      allow read: if isAdmin() || (hasAcct() && resource.data.eleve == myRef());
      allow write: if isAdmin();
    }
    match /compta-factures/{id} {
      allow read, write: if isAdmin();
    }
    match /compta-paie/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.ens == myRef());
      allow write: if isAdmin();
    }
    match /compta-reglages/{id} {
      allow read, write: if isAdmin();
    }
    // Années clôturées : le résumé et le contenu en morceaux, pour l’administration seulement
    match /archives/{id} {
      allow read, write: if isAdmin();
    }
    match /archives-parts/{id} {
      allow read, write: if isAdmin();
    }
    match /candidatures/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.enseignant == myRef() && (request.resource.data.statut == 'attente'
        || (request.resource.data.statut == 'approuve' && get(/databases/$(database)/documents/config/ecole).data.get('perms', {}).get('auto', false) == true)));
      allow delete: if isAdmin() || (isTeacher() && resource.data.enseignant == myRef() && resource.data.statut == 'attente');
    }
    // Demandes de remplacement : l’enseignant attribué envoie ou annule la sienne
    match /remplacements/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.enseignant == myRef());
      allow delete: if isAdmin() || (isTeacher() && resource.data.enseignant == myRef());
    }
    // Disponibilités : chaque enseignant écrit les siennes
    match /disponibilites/{tid} {
      allow read: if isStaff();
      allow write: if isAdmin() || (isTeacher() && tid == myRef());
    }

    // Historique des actions : le personnel y inscrit ce qu’il fait (une entrée par action, un document par mois) ;
    // seule l’administration le lit
    match /journal/{id} {
      allow read: if isAdmin();
      allow create, update: if isStaff();
    }

    // Résultats d’examens : le personnel voit tout ; chaque élève ne lit que les siens
    match /resultats/{id} { allow read, write: if isStaff(); }
    match /resultats-eleves/{id} {
      allow read: if isStaff() || (hasAcct() && resource.data.eleve == myRef());
      allow write: if isStaff();
    }

    // Comptes : chacun lit le sien ; l’administration les gère tous
    match /comptes/{uid} {
      allow read: if isAdmin() || self(uid);
      allow write: if isAdmin();
    }
    // Demandes de compte : chacun envoie la sienne ; l’administration l’approuve ou la refuse
    match /demandes/{uid} {
      allow read: if isAdmin() || self(uid);
      allow create, update: if isAdmin() || (self(uid) && request.resource.data.statut == 'en attente');
      allow delete: if isAdmin();
    }
    // Nom et courriel de chaque personne inscrite
    match /profils/{uid} {
      allow read: if isAdmin() || self(uid);
      allow write: if self(uid) || isAdmin();
    }
  }
}
